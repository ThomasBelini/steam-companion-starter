{
  "name": "steam-companion-starter",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle -- --locked",
    "desktop:bundle": "tauri build --bundles nsis -- --locked",
    "desktop:info": "tauri info",
    "desktop:pairing": "cargo run --manifest-path src-tauri/Cargo.toml --locked --features pairing-prototype --example pairing-lab -- --simulate",
    "desktop:pairing:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features pairing-prototype --example pairing-lab && cargo build --manifest-path src-tauri/Cargo.toml --locked --features pairing-prototype --example pairing-lab && node scripts/test-pairing-browser.mjs",
    "desktop:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck:backend",
    "typecheck:backend": "tsc -p backend/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && npm run test:backend",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run backend:db:migrate && npm test && npm run test:browser && npm run build && npm run backend:build",
    "backend:dev": "wrangler dev --local --config backend/wrangler.jsonc --persist-to .wrangler/state",
    "backend:db:migrate": "wrangler d1 migrations apply DB --local --config backend/wrangler.jsonc --persist-to .wrangler/state",
    "backend:build": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir dist/backend",
    "test:backend": "vitest run --config vitest.backend.config.ts"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "ignore": "^7.0.14",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
